(defun factorial (n)
  (if (<= n 1) 1 (* n (factorial (- n 1)))))
(print (factorial 8))
(defun add-three (a b c)
  (let ((sum (+ a b))) (+ sum c)))
(print (add-three 10 20 12))
(defmacro twice (x) `(+ ,x ,x))
(print (twice 21))
(defun fib (n)
  (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(print (fib 10))
