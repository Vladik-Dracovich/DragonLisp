(defun make-adder (x)
  (lambda (y) (+ x y)))
(defparameter add-seven (make-adder 7))
(print (funcall add-seven 35))
(print (funcall (make-adder 100) 23))
(print (let ((x 8)) (funcall (lambda (y) (+ x y)) 9)))
(defun make-counter (start)
  (let ((n start))
    (lambda () (setq n (+ n 1)) n)))
(defparameter counter (make-counter 10))
(print (funcall counter))
(print (funcall counter))
(defun factorial16 (n)
  (if (<= n 1) 1 (* n (factorial16 (- n 1)))))
(print (factorial16 6))
