(defun sum-all (&rest xs) (reduce (lambda (a b) (+ a b)) (cons 0 xs)))
(print (sum-all))
(print (sum-all 1 2 3 4 5))
(defun prefix (first &rest others) (cons first others))
(print (prefix 10 20 30 40))
(defun make-collector (head)
  (lambda (&rest tail) (cons head tail)))
(defparameter collect (make-collector 9))
(print (funcall collect 8 7 6))
(print (funcall collect))
(defun make-rest-counter (start)
  (lambda (&rest increments)
    (setq start (+ start (reduce (lambda (a b) (+ a b)) (cons 0 increments))))
    start))
(defparameter count-rest (make-rest-counter 10))
(print (funcall count-rest 1 2 3))
(print (funcall count-rest 4))
(defun body-test (a &body b) (cons a b))
(print (body-test 1 2 3))
