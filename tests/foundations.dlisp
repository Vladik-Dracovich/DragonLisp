(defun assert-equal (actual expected)
  (unless (equal actual expected)
    (error "Assertion failed")))
(assert-equal (+ 9223372036854775807 1) 9223372036854775808)
(assert-equal (* 999999999999999999999 999999999999999999999) 999999999999999999998000000000000000000001)
(assert-equal (/ 1 4) 1/4)
(assert-equal (type-of 9223372036854775808) 'integer)
(assert-equal (typep 1 'integer) t)
(assert-equal (typep "hello" 'string) t)
(assert-equal (let* ((a 2) (b (+ a 3))) b) 5)
(assert-equal (and t 5) 5)
(assert-equal (or nil 12) 12)
(assert-equal (append '(1 2) '(3 4)) '(1 2 3 4))
(assert-equal (reverse '(1 2 3)) '(3 2 1))
(assert-equal (nth 1 '(10 20 30)) 20)
(assert-equal (funcall (lambda (x) (+ x 2)) 40) 42)
(assert-equal (apply + '(1 2 3)) 6)
(defun sum-rest (x &rest more) (apply + x more))
(assert-equal (sum-rest 1 2 3 4) 10)
(defmacro unless2 (condition &body forms) `(if (not ,condition) (progn ,@forms)))
(assert-equal (unless2 nil (+ 10 20)) 30)
(defun typed-square (x) (declare (type integer x)) (* x x))
(assert-equal (typed-square 9) 81)
(print "DragonLisp foundation tests passed")
