(defun assert-equal (actual expected)
  (unless (equal actual expected) (error "Assertion failed")))
(assert-equal (+ 1/2 1/3) 5/6)
(assert-equal (* 3/4 8/9) 2/3)
(assert-equal (/ 5 2) 5/2)
(assert-equal (numerator 6/8) 3)
(assert-equal (denominator 6/8) 4)
(assert-equal (typep 1/3 'ratio) t)
(import "java.lang.StringBuilder")
(defparameter sb (java/new "StringBuilder"))
(java/call sb "append" "dragon")
(java/call sb "append" "lisp")
(assert-equal (java/call sb "toString") "dragonlisp")
(assert-equal (java/static "java.lang.Math" "max" 7 11) 11)
(print "DragonLisp 0.3/0.4 tests passed")
